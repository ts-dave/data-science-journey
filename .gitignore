# Keep the data folder structure, but ignore its contents
/data/*
!/data/raw/
!/data/interim/
!/data/processed/
!/data/external/
/data/raw/*
/data/interim/*
/data/processed/*
/data/external/*
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep
!/data/external/.gitkeep

